{
  "expo": {
    "name": "HamaLog",
    "slug": "hamalog-rn",
    "version": "1.0.0",
    "scheme": "hamalog-rn",
    "description": "정신적 어려움을 겪는 분들을 대상으로 약 처방·복용 관리+일기 작성을 통해 스스로를 돌볼 수 있도록 도와주는 서비스 하마로그",
    "keywords": [
      "mental-health",
      "mental-illness",
      "mental-disorder",
      "mental-health-app",
      "mental-health-support",
      "mental-health-management",
      "mental-health-therapy",
      "mental-health-treatment"
    ],
    "category": "health",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hamalog.hamalog",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.hamalog.hamalog",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "RECORD_AUDIO"
      ]
    }
  }
}
