{
  "cli": {
    "version": ">= 14.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "NODE_ENV": "development",
        "EXPO_PUBLIC_API_BASE_URL": "http://112.72.248.195:8080",
        "EXPO_PUBLIC_MOCK_AUTH": "true",
        "EXPO_PUBLIC_MOCK_USER_ID": "1",
        "EXPO_PUBLIC_MOCK_USER_NAME": "개발자",
        "EXPO_PUBLIC_MOCK_USER_EMAIL": "dev@hamalog.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "NODE_ENV": "preview",
        "EXPO_PUBLIC_API_BASE_URL": "http://112.72.248.195:8080"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "http://112.72.248.195:8080"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./service-account-key.json",
        "track": "production"
      },
      "ios": {
        "appleId": "hamalog.official@gmail.com",
        "ascAppId": "APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "APPLE_TEAM_ID"
      }
    }
  }
}
