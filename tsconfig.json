{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",

    "baseUrl": ".",
    "paths": {
      "@widgets": ["src/widgets"],
      "@widgets/*": ["src/widgets/*"],
      "@features": ["src/features"],
      "@features/*": ["src/features/*"],
      "@entities": ["src/entities"],
      "@entities/*": ["src/entities/*"],
      "@shared": ["src/shared"],
      "@shared/*": ["src/shared/*"],
    },
  },
}
