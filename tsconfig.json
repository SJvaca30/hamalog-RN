{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@assets": ["assets"],
      "@assets/*": ["assets/*"],
      "@application": ["src/application"],
      "@application/*": ["src/application/*"],
      "@pages": ["src/pages"],
      "@pages/*": ["src/pages/*"],
      "@widgets": ["src/widgets"],
      "@widgets/*": ["src/widgets/*"],
      "@features": ["src/features"],
      "@features/*": ["src/features/*"],
      "@entities": ["src/entities"],
      "@entities/*": ["src/entities/*"],
      "@shared": ["src/shared"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "exclude": ["node_modules"],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
